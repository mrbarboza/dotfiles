# Theme (wezterm: color_scheme = "rose-pine-moon")
theme = Rose Pine Moon

# Font (wezterm: Hack Nerd Font DemiBold, size 15 on macOS)
# No DemiBold instance installed for this family, thicken approximates it
font-family = Hack Nerd Font
font-size = 15
font-thicken = true

# Window (wezterm: window_decorations = "RESIZE")
# auto keeps a real titlebar object so macos-titlebar-style below can theme it;
# false leaves an unthemed gray strip behind the traffic lights
window-decoration = auto
macos-titlebar-style = transparent
macos-titlebar-proxy-icon = hidden
window-padding-y = 8

# Background (wezterm macOS: opacity 0.8, blur 50)
background-opacity = 0.8
background-blur = 50

# Inactive split dimming (wezterm: inactive_pane_hsb brightness 0.5)
unfocused-split-opacity = 0.5

# macOS behavior
macos-option-as-alt = true
mouse-hide-while-typing = true

# Keybindings (wezterm: CTRL-q fullscreen, CTRL-' clear scrollback)
keybind = ctrl+q=toggle_fullscreen
keybind = ctrl+'=clear_screen
